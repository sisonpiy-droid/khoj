# QuickCommerce API (https://quickcommerceapi.com/docs).
# Leave QUICKCOMMERCE_API_KEY blank to run entirely on the built-in mock
# provider — the app works fully without any key.
QUICKCOMMERCE_API_KEY=

# Optional override: "true" forces mock data even if a key is set above,
# "false" forces the real API (and will error without a valid key).
# Default (unset): mock unless QUICKCOMMERCE_API_KEY is present.
QUICKCOMMERCE_USE_MOCK=
